<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_habit"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_new"
        android:shortcutLongLabel="@string/shortcut_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.savcuit.habittracker"
            android:targetClass="com.savcuit.habittracker.MainActivity">
            <extra android:name="page" android:value="new" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="stats"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_stats"
        android:shortcutLongLabel="@string/shortcut_stats_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.savcuit.habittracker"
            android:targetClass="com.savcuit.habittracker.MainActivity">
            <extra android:name="page" android:value="stats" />
        </intent>
    </shortcut>
</shortcuts>
